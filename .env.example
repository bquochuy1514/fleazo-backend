# ===========================
# App
# ===========================
PORT=8080
FRONTEND_URL=http://localhost:3000

# ===========================
# Database (Prisma + Postgres)
# ===========================
DATABASE_URL=

# ===========================
# Auth — JWT
# ===========================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ===========================
# Auth — Google OAuth
# ===========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# ===========================
# Image uploads — Cloudinary
# ===========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================
# Outgoing mail (OTP verification, password reset) — Resend, not SMTP.
# Most PaaS free tiers block outbound SMTP, so a raw SMTP transport
# (Nodemailer/Gmail) silently fails to send in production even though it
# works fine locally.
# ===========================
RESEND_API_KEY=
# "Fleazo <onboarding@resend.dev>" (Resend's sandbox sender) until a real
# domain is verified on Resend — sandbox only delivers to the Resend
# account's own email, fine for dev but not real users.
MAIL_FROM=

# ===========================
# Membership payments — PayOS
# ===========================
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ===========================
# fleazo-ai integration — shared-secret header auth.
# FLEAZO_AI_INTERNAL_API_KEY must match fleazo-ai's BACKEND_INTERNAL_API_KEY exactly.
# ===========================
FLEAZO_AI_BASE_URL=http://localhost:8000
FLEAZO_AI_INTERNAL_API_KEY=
