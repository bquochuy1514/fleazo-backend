generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ProductStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  SOLD
  EXPIRED
  BANNED
  CANCELLED
}

model User {
  // — Identity —
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String?

  // — Profile —
  fullName String   @map("full_name")
  phone    String?  @db.VarChar(20)
  avatar   String   @default("https://res.cloudinary.com/dazcuspid/image/upload/default-avatar_v8w01n.png")
  role     UserRole @default(CUSTOMER)

  // — Location (optional, 2-level structure — for location-based features) —
  provinceCode  Int?    @map("province_code")
  provinceName  String? @map("province_name")
  wardCode      Int?    @map("ward_code")
  wardName      String? @map("ward_name")
  addressDetail String? @map("address_detail")

  // — Account status —
  isActive Boolean @default(false) @map("is_active")
  isBanned Boolean @default(false) @map("is_banned")

  // — Account activation (email OTP) —
  codeOtp           String?   @map("code_otp") @db.VarChar(6)
  codeOtpExpiration DateTime? @map("code_otp_expiration")

  // — Password reset —
  isOtpVerified Boolean @default(false) @map("is_otp_verified")

  // — Auth tokens —
  hashedRefreshToken String? @map("hashed_refresh_token")

  // — Seller trust signals (from Reviews/Chat/Products, not yet wired up) —
  avgRating      Float @default(0) @map("avg_rating")
  completionRate Float @default(0) @map("completion_rate")
  responseRate   Float @default(0) @map("response_rate")

  // — University (optional student identity, NOT required to sell) —
  universityId Int?        @map("university_id")
  university   University? @relation(fields: [universityId], references: [id])

  // — Relations —
  products               Product[]
  savedProducts          SavedProduct[]
  reviewsWritten         Review[]       @relation("ReviewsWritten")
  reviewsReceived        Review[]       @relation("ReviewsReceived")
  conversationsInitiated Conversation[] @relation("ConversationsInitiated")
  conversationsReceived  Conversation[] @relation("ConversationsReceived")
  messagesSent           Message[]      @relation("MessagesSent")

  // — Timestamps —
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Category {
  // — Identity —
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique
  // Transparent PNG cutout for the homepage category circles. Root
  // categories only — the frontend section that renders these never shows
  // leaf categories. Recommended source: 1:1 square, subject centered with
  // margin (not edge-to-edge), ≥400×400px, transparent background.
  image String?

  // — Hierarchy —
  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  // — Relations —
  products Product[]

  // — Timestamps —
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model University {
  // — Identity —
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  // — Relations —
  users User[]

  // — Timestamps —
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("universities")
}

model Product {
  // — Identity —
  id          Int     @id @default(autoincrement())
  title       String
  description String  @db.Text
  price       Decimal @db.Decimal(12, 0)

  // — Location (2-level structure, post-2025 administrative merger) —
  provinceCode  Int     @map("province_code")
  provinceName  String  @map("province_name")
  wardCode      Int     @map("ward_code")
  wardName      String  @map("ward_name")
  addressDetail String? @map("address_detail")

  // — Condition & status —
  condition      ProductCondition
  status         ProductStatus    @default(DRAFT)
  rejectedReason String?          @map("rejected_reason")

  // — Monetization —
  expiresAt      DateTime? @map("expires_at")
  boostExpiresAt DateTime? @map("boost_expires_at")

  // — Quality Score —
  qualityScore Float @default(0) @map("quality_score")
  saveCount    Int   @default(0) @map("save_count")

  // — Relations —
  sellerId   Int              @map("seller_id")
  seller     User             @relation(fields: [sellerId], references: [id])
  categoryId Int              @map("category_id")
  category   Category         @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  savedBy    SavedProduct[]
  reviews    Review[]
  messages   Message[]
  // Pending edit awaiting admin re-approval; only set while status is ACTIVE, at most one at a time (1:1).
  revision   ProductRevision?

  // — Timestamps —
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model ProductImage {
  // — Identity —
  id       Int    @id @default(autoincrement())
  url      String
  publicId String @map("public_id")
  order    Int    @default(0)

  // — Relations —
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // — Timestamps —
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_images")
}

// A seller's proposed edit to an already-ACTIVE listing, kept separate from the live Product
// rows until an admin approves or rejects it. No status field — the row's existence IS "pending".
model ProductRevision {
  // — Identity —
  id Int @id @default(autoincrement())

  // — Proposed content (full snapshot, not a diff — approve is a straight field copy) —
  title         String
  description   String           @db.Text
  price         Decimal          @db.Decimal(12, 0)
  condition     ProductCondition
  categoryId    Int              @map("category_id")
  provinceCode  Int              @map("province_code")
  provinceName  String           @map("province_name")
  wardCode      Int              @map("ward_code")
  wardName      String           @map("ward_name")
  addressDetail String?          @map("address_detail")

  // — Relations —
  productId Int                    @unique @map("product_id")
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  images    ProductRevisionImage[]

  // — Timestamps —
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_revisions")
}

// Snapshot of what Product's images would become if approved; never references the live ProductImage rows directly.
model ProductRevisionImage {
  // — Identity —
  id       Int    @id @default(autoincrement())
  url      String
  publicId String @map("public_id")
  order    Int    @default(0)

  // — Relations —
  revisionId Int             @map("revision_id")
  revision   ProductRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@map("product_revision_images")
}

model SavedProduct {
  // — Relations —
  userId    Int     @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // — Timestamps —
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, productId])
  @@map("saved_products")
}

model Review {
  // — Identity —
  id Int @id @default(autoincrement())

  // — Relations —
  reviewerId Int     @map("reviewer_id")
  reviewer   User    @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  sellerId   Int     @map("seller_id")
  seller     User    @relation("ReviewsReceived", fields: [sellerId], references: [id])
  productId  Int     @map("product_id")
  product    Product @relation(fields: [productId], references: [id])

  // — Content —
  rating      Int
  comment     String? @db.Text
  sellerReply String? @map("seller_reply") @db.Text

  // — Moderation (published immediately, no pre-moderation hold, no isPublished field) —
  isHidden Boolean @default(false) @map("is_hidden")

  // — Timestamps —
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([reviewerId, sellerId])
  @@map("reviews")
}

model Conversation {
  // — Identity —
  id Int @id @default(autoincrement())

  // — Relations — initiator/recipient are NOT buyer/seller; role depends on the product, not the conversation —
  initiatorId Int  @map("initiator_id")
  initiator   User @relation("ConversationsInitiated", fields: [initiatorId], references: [id])
  recipientId Int  @map("recipient_id")
  recipient   User @relation("ConversationsReceived", fields: [recipientId], references: [id])

  // — Relations —
  messages Message[]

  // — Timestamps — updatedAt bumped on every new message, used to sort inbox
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([initiatorId, recipientId])
  @@map("conversations")
}

model Message {
  // — Identity —
  id Int @id @default(autoincrement())

  // — Relations —
  conversationId Int          @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int          @map("sender_id")
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id])

  // Which product this message is about (nullable); cross-referenced against Product.sellerId for the Reviews gate check.
  productId Int?     @map("product_id")
  product   Product? @relation(fields: [productId], references: [id])

  // Quote-reply only (not threading); service layer enforces the same-conversation constraint since Prisma can't express it across two FKs.
  // onDelete: SetNull, not Cascade — a reply shouldn't lose its own content just because the quoted message was deleted.
  replyToId Int?      @map("reply_to_id")
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  // — Content — recall is soft-hide only (content stays in DB); frontend shows "message recalled" when isRecalled is true, including for a recalled message quoted via replyTo —
  content    String  @db.Text
  isRead     Boolean @default(false) @map("is_read")
  isRecalled Boolean @default(false) @map("is_recalled")

  // — Timestamps —
  createdAt DateTime @default(now()) @map("created_at")

  @@map("messages")
}

// be used for reset data: npx prisma db push --force-reset --accept-data-loss
